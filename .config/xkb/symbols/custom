// US layout with ESC remapped to grave/tilde
partial alphanumeric_keys modifier_keys
xkb_symbols "us_esc_grave" {
    include "us"
    replace key <ESC> { [ grave, asciitilde ] };
};

// Bulgarian phonetic with ESC remapped to che
partial alphanumeric_keys modifier_keys
xkb_symbols "bg_phonetic_esc_grave" {
    include "bg(phonetic)"
    replace key <ESC> { [ Cyrillic_che, Cyrillic_CHE ] };
};
